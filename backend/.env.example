# Copier ce fichier en `.env` : cp .env.example .env
# Les valeurs ci-dessous fonctionnent telles quelles en développement.

# development | production | test
# En production : logs JSON et documentation interactive (/docs, /redoc) masquée.
ENVIRONMENT=development

# SQLite en dev (fichier ./app.db, aucun setup).
# PostgreSQL en prod : postgresql+psycopg://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./app.db

# Origines autorisées par CORS, séparées par des virgules (frontend Angular).
CORS_ORIGINS=http://localhost:4200

# Fuseau utilisé pour déterminer « aujourd'hui » dans le tableau de bord.
# Liste des fuseaux : https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
APP_TIMEZONE=Indian/Antananarivo

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Signe les tokens d'accès (JWT). Obligatoire en prod : au moins 32 caractères aléatoires.
# Générer avec : python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production

# ─── Authentification ───────────────────────────────────────────────

# Durée de vie du token d'accès (minutes) et du refresh token (jours).
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Verrouillage du compte après N échecs de connexion, pendant LOCKOUT_MINUTES minutes.
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# Cookie du refresh token : lax | strict | none.
# lax si front et API partagent le même site (localhost:4200 + localhost:8000 = OK).
# none si les sites diffèrent (HTTPS obligatoire).
COOKIE_SAMESITE=lax

# ─── Premier administrateur ─────────────────────────────────────────

# Créé au démarrage s'il n'existe aucun admin actif. Démarrer une fois,
# puis RETIRER le mot de passe de ce fichier.
BOOTSTRAP_ADMIN_EMAIL=admin@local.com
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Administrateur

# ─── IA : analyse des demandes (Gemini) ─────────────────────────────

# Clé à créer sur https://aistudio.google.com/apikey — ne jamais la commiter.
# Sans clé, le bouton « Analyser la demande » répond « IA non configurée » (503).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ─── API Terra Nova : demandes du concours ──────────────────────────

# Clé de l'équipe (annexe du sujet) — ne jamais la commiter.
TERRA_NOVA_API_URL=https://24h.webcup.fr/wp-json/webcup/v1/requests
TERRA_NOVA_API_KEY=
# Interrogation toutes les N secondes, indépendamment du compte à rebours des vagues.
TERRA_NOVA_SYNC_SECONDS=30
# Délai maximal d'attente d'une réponse de l'API Terra Nova (secondes).
TERRA_NOVA_TIMEOUT_SECONDS=15
# false pour couper la boucle de fond (la synchro se fait alors à la lecture).
TERRA_NOVA_BACKGROUND_SYNC=true
